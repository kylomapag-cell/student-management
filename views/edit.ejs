<%- include('partials/header', { title: 'Edit Student - Student Management System' }) %>

<div class="card form-card">
  <div class="page-header">
    <div>
      <h1 class="page-title">Edit Student Details</h1>
      <p class="page-subtitle">Update information for <%= student.first_name %> <%= student.last_name %></p>
    </div>
  </div>

  <% if (typeof error !== 'undefined' && error) { %>
    <div class="alert alert-danger">
      <%= error %>
    </div>
  <% } %>

  <form action="/students/edit/<%= student.id %>" method="POST" novalidate>
    <div class="form-group">
      <label class="form-label" for="student_id">Student ID</label>
      <input 
        type="text" 
        id="student_id" 
        name="student_id" 
        class="form-control" 
        value="<%= (typeof formData !== 'undefined' && formData && formData.student_id) ? formData.student_id : student.student_id %>" 
        required
      >
    </div>

    <div class="form-group">
      <label class="form-label" for="first_name">First Name</label>
      <input 
        type="text" 
        id="first_name" 
        name="first_name" 
        class="form-control" 
        value="<%= (typeof formData !== 'undefined' && formData && formData.first_name) ? formData.first_name : student.first_name %>" 
        required
      >
    </div>

    <div class="form-group">
      <label class="form-label" for="last_name">Last Name</label>
      <input 
        type="text" 
        id="last_name" 
        name="last_name" 
        class="form-control" 
        value="<%= (typeof formData !== 'undefined' && formData && formData.last_name) ? formData.last_name : student.last_name %>" 
        required
      >
    </div>

    <div class="form-group">
      <label class="form-label" for="course">Course</label>
      <input 
        type="text" 
        id="course" 
        name="course" 
        class="form-control" 
        value="<%= (typeof formData !== 'undefined' && formData && formData.course) ? formData.course : student.course %>" 
        required
      >
    </div>

    <div class="form-group">
      <label class="form-label" for="year_level">Year Level (1-5)</label>
      <input 
        type="number" 
        id="year_level" 
        name="year_level" 
        class="form-control" 
        min="1" 
        max="5" 
        value="<%= (typeof formData !== 'undefined' && formData && formData.year_level) ? formData.year_level : student.year_level %>" 
        required
      >
    </div>

    <div class="form-group">
      <label class="form-label" for="email">Email Address</label>
      <input 
        type="email" 
        id="email" 
        name="email" 
        class="form-control" 
        value="<%= (typeof formData !== 'undefined' && formData && formData.email) ? formData.email : student.email %>" 
        required
      >
    </div>

    <div class="form-actions">
      <button type="submit" class="btn btn-primary">Update Student</button>
      <a href="/" class="btn btn-secondary">Cancel</a>
    </div>
  </form>
</div>

<%- include('partials/footer') %>
